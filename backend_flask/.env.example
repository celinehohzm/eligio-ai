# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=replace-me

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# Database Configuration
# For local development, leave DATABASE_URL empty to use SQLite.
# For Azure PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://<user>:<password>@<server>.postgres.database.azure.com:5432/eligio?sslmode=require
DATABASE_URL=
AUTO_CREATE_TABLES=true

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JWT Configuration
JWT_SECRET_KEY=replace-me
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=1209600

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png
UPLOAD_API_KEY=
ENABLE_PDF_OCR=true
PDF_OCR_LANGUAGE=eng
PDF_OCR_TRIGGER_MIN_CHARS=32
PDF_OCR_TESSERACT_TIMEOUT=180
PDF_OCR_PROCESS_TIMEOUT=240

# Storage Configuration
# local or azure
STORAGE_PROVIDER=local
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_HEADERS_ENABLED=true
DEFAULT_RATE_LIMITS=300 per hour,100 per minute

# CORS and Host Controls
# Comma-separated list in production.
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=

# Transport + Security Headers
TRUST_PROXY=false
FORCE_HTTPS=false
ENABLE_SECURITY_HEADERS=true
